# Copy this file to .env (same folder) to save students, weekly lessons and notes on the backend instead of the phone.
# Use your Mac's Wi-Fi address (System Settings → Wi-Fi → Details), not localhost: the phone
# can't reach "localhost" on your Mac. Keep the phone on the same Wi-Fi. Restart Expo after changing it.
# The iOS Simulator can use http://localhost:8080/api.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api
